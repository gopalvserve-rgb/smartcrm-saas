# ============================================================
# SmartCRM SaaS — environment variables
# ============================================================
# Copy to .env locally, or set on Railway, and fill real values.

# --- Postgres -----------------------------------------------
# Single Postgres cluster. The control DB is `smartcrm_control`,
# tenant DBs (tenant_<slug>) are auto-created on signup.
CONTROL_DATABASE_URL=postgres://user:pass@host:5432/smartcrm_control?sslmode=require

# --- App ----------------------------------------------------
PORT=3000
PUBLIC_BASE_URL=https://crm.smartcrmsolution.com
JWT_SECRET=change-me-to-a-long-random-string

# --- Cashfree (set via Admin → Settings, env is fallback) ---
CASHFREE_APP_ID=
CASHFREE_SECRET=
CASHFREE_MODE=PROD

# --- Email (set via Admin → Settings, env is fallback) -----
MAIL_PROVIDER=gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=
SENDGRID_API_KEY=
MAIL_FROM=

# --- Bootstrap super-admin (used by control/seed.js) -------
SEED_ADMIN_EMAIL=admin@smartcrmsolution.com
SEED_ADMIN_PASSWORD=

# R2_RECORDINGS_v1 — Cloudflare R2 storage for call recordings (zero-egress).
# Leave blank to keep storing recordings in Postgres (default behaviour).
# R2_ENDPOINT must be the account S3 endpoint WITHOUT the bucket suffix.
R2_ENDPOINT=
R2_BUCKET=smartcrm-recordings
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=

# R2_STORE_v1 — general tenant-file offload (ticket attachments, storefront
# media, receipts, KB files…). SEPARATE buckets from recordings above so the
# two never collide. Reuses R2_ENDPOINT + R2_ACCESS_KEY_ID + R2_SECRET_ACCESS_KEY.
# Keys must have access to both buckets below.
R2_PRIVATE_BUCKET=smartcrm-saas
R2_PUBLIC_BUCKET=smartcrm-saas-public
R2_PUBLIC_BASE_URL=
# Rollout lever: off (default, pure Postgres) | write (dual-write, still serve
# BYTEA) | on (serve from R2 with BYTEA fallback). Flip on↔off to roll out/back.
R2_OFFLOAD=off
